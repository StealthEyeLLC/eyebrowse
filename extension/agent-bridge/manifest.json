{
  "manifest_version": 3,
  "name": "eyebrowse agent bridge",
  "version": "0.1.0",
  "description": "Document-resident identity and event sensing for eyebrowse.",
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
